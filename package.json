{
  "name": "canadian-iptv-player",
  "version": "1.0.0",
  "description": "A Canadian live IPTV player with 100% legal Canadian English specialty TV networks, TV guide, EPG, and timeline filtering (2005-2013)",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && nodemon index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "iptv",
    "canadian",
    "tv-player",
    "epg",
    "streaming",
    "hls",
    "dash"
  ],
  "author": "papice599",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  }
}
